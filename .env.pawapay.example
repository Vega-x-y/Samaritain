# ========================================
# PawaPay Mobile Money Configuration
# ========================================
# 
# Configuration for PawaPay payment gateway integration.
# Copy these variables to your .env file and fill in your values.
#

# Environment: 'sandbox' or 'production'
# Sandbox: https://api.sandbox.pawapay.io
# Production: https://api.pawapay.io
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io

# API Token
# Generate from PawaPay Dashboard → System Configuration → API Tokens
# IMPORTANT: Sandbox and production tokens are different!
PAWAPAY_TOKEN=

# Default currency (ISO 4217 code)
# Common codes:
# - CDF: Congolese Franc (DRC)
# - XAF: Central African CFA Franc (Congo-Brazzaville, Cameroon, etc.)
# - ZMW: Zambian Kwacha
# - KES: Kenyan Shilling
# - UGX: Ugandan Shilling
# - NGN: Nigerian Naira
PAWAPAY_DEFAULT_CURRENCY=CDF

# Callback URL (must be publicly accessible via HTTPS in production)
# Configure this same URL in PawaPay Dashboard → System Configuration → Callback URLs
PAWAPAY_CALLBACK_URL=${APP_URL}/webhooks/pawapay/callback

# Return URL for hosted payment pages
# Where users are redirected after completing payment on PawaPay's page
PAWAPAY_RETURN_URL=${APP_URL}/payments/return

# Verify callback signatures (RFC-9421)
# Set to true in production for enhanced security
# Requires configuring public keys in PawaPay Dashboard
PAWAPAY_VERIFY_CALLBACK_SIGNATURE=false

# API timeout (seconds)
PAWAPAY_TIMEOUT=30

# Number of retry attempts for failed API requests
PAWAPAY_RETRY_TIMES=2
